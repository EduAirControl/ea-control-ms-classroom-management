# ms-classroom-management - variables de entorno.
# Copia a .env y ajusta los valores. No subas nunca un .env con secretos.

# Servidor
SERVER_PORT=3002

# PostgreSQL (ADR-003)
POSTGRES_URL=jdbc:postgresql://localhost:5433/eduaircontrol_classrooms
POSTGRES_USER=classroom_user
POSTGRES_PASSWORD=change-me

# Seguridad (ADR-006/018): access tokens RS256 validados contra el JWKS de ms-security
JWKS_URI=http://localhost:8081/api/v1/auth/jwks
JWT_PUBLIC_KEY_PATH=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# RabbitMQ / outbox de eventos de aulas (ADR-007)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
CLASSROOM_EVENTS_EXCHANGE=eduaircontrol.classroom
